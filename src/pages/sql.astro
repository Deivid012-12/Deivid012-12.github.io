---
import Layout from "../layouts/MainLayout.astro";
---

<Layout title="SQL">
  <section class="page">
    <h1>Consultas SQL</h1>

    <p>
      Se presentan consultas, creación de tablas, relaciones, procedimientos
      almacenados y manipulación avanzada de datos.
    </p>

    <a href="/" class="btn-home reveal">← Volver al inicio</a>
  </section>
</Layout>

<style>
  .page {
    max-width: 900px;
    margin: 80px auto;
    padding: 40px;
    background: #0f172a;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,.5);
    text-align: center;
    color: #e5e7eb;
  }

  .code {
    background: #020617;
    padding: 15px;
    border-radius: 8px;
    text-align: left;
    margin-top: 20px;
    overflow-x: auto;
  }
   .btn-home {
  position: fixed;
  bottom: 30px;
  left: 30px; 

  padding: 12px 18px;
  background: var(--bg-soft);
  color: var(--text);
  text-decoration: none;

  border-radius: 12px;
  border: 1px solid var(--border);
  font-size: 14px;
  font-weight: 500;

  box-shadow: 0 10px 30px rgba(0,0,0,.5);
  backdrop-filter: blur(6px);

  transition: all 0.3s ease;
  z-index: 1000;
}


 .btn-home:hover {
  background: var(--accent);
  color: white;
  transform: translateY(-3px) scale(1.05);
  box-shadow: 0 15px 35px rgba(12, 12, 12, 0.4);
}
</style>
